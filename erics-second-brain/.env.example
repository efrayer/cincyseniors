# ── Eric's Second Brain — configuration ──────────────────────────
# Copy to .env (docker compose reads it automatically; for bare-node
# runs, export these or use `node --env-file=.env`).

# Path prefix the app is served under. Caddy forwards it INTACT.
# Must start with "/" and have no trailing slash. Changing it requires
# a client rebuild (it is baked into asset URLs at build time).
BASE_PATH=/erics_second_brain

# Internal port the app listens on (not published to the host).
PORT=3111

# Where the SQLite database + backups live. In Docker this is a volume.
DATA_DIR=./data

# ── Auth (single user) ───────────────────────────────────────────
AUTH_USERNAME=eric
# Generate with:  npm run hash-password -- 'your-password-here'
AUTH_PASSWORD_HASH=

# Set to "true" ONLY if the app is fully protected by Cloudflare Access
# and you want to disable the built-in login. See README §Cloudflare Access.
AUTH_DISABLED=false

# Session lifetime in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Send the session cookie with the Secure flag. Keep "true" in production
# (the browser talks to Cloudflare over HTTPS even though the app itself
# is plain HTTP behind the tunnel). Set "false" only for local http dev.
COOKIE_SECURE=true

# ── Optional AI module (§7) — fully opt-in, off by default ───────
# When disabled, no AI code runs and no note content ever leaves the box.
AI_ENABLED=false
# Your own Anthropic API key (required if AI_ENABLED=true).
ANTHROPIC_API_KEY=
# Model for distill assist + chat.
AI_MODEL=claude-opus-4-6
