# Copy this file to .env and fill in real values. .env is gitignored.

# Bcrypt hash protecting /cindy/admin, /cindy/chat-log, /cindy/rag-admin
# (HTTP Basic Auth, username "admin"). Generate with:
#   docker run --rm caddy:latest caddy hash-password --plaintext 'your-password'
# Then escape every literal "$" as "$$" when pasting the hash here,
# since docker-compose treats a single "$" as the start of a variable reference.
CADDY_ADMIN_HASH=$$2a$$14$$REPLACE_WITH_REAL_HASH
